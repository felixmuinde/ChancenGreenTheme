  "semanticTokenColors": {
    "namespace": "#7fe0b0",
    "class": "#84BD00",
    "interface": "#84BD00",
    "enum": "#84BD00",
    "typeParameter": "#84BD00",
    "function": "#7fe0b0",
    "method": "#7fe0b0",
    "property": "#ece9e1",
    "parameter": { "foreground": "#c9d8a0", "italic": true },
    "variable.readonly": "#f0a35e"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6f8f78", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#e3c78a" }
    },
    {
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": { "foreground": "#f0a35e" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.other"],
      "settings": { "foreground": "#f0a35e" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "keyword.operator.new"],
      "settings": { "foreground": "#a0d931" }
    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#a8c4ac" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#7fe0b0" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class"],
      "settings": { "foreground": "#84BD00" }
    },
    {
      "scope": ["variable", "variable.other", "meta.object-literal.key"],
      "settings": { "foreground": "#ece9e1" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#c9d8a0", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#a0d931" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#e3c78a" }
    },
    {
      "scope": ["support.type.property-name", "meta.property-name"],
      "settings": { "foreground": "#84BD00" }
    },
    {
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#8fae9b" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#a0d931", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#f6f4ee", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#e3c78a" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#7fd1c7" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#7fbf6a" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#f87171" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#f87171" }
    }
  ]
}
