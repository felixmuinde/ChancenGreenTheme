    "terminal.ansiWhite": "#d4e0d6",
    "terminal.ansiBrightBlack": "#6f8f78",
    "terminal.ansiBrightRed": "#fca5a5",
    "terminal.ansiBrightGreen": "#a0d931",
    "terminal.ansiBrightYellow": "#f3d08a",
    "terminal.ansiBrightBlue": "#9acdee",
    "terminal.ansiBrightMagenta": "#dcb9ea",
    "terminal.ansiBrightCyan": "#a8e6df",
    "terminal.ansiBrightWhite": "#ffffff"
