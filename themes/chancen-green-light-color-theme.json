    "terminal.ansiGreen": "#2f6a3a",
    "terminal.ansiYellow": "#8a5a00",
    "terminal.ansiBlue": "#1d5f99",
    "terminal.ansiMagenta": "#8a3f9e",
    "terminal.ansiCyan": "#0f6b6b",
    "terminal.ansiWhite": "#5f7466",
    "terminal.ansiBrightBlack": "#4f6657",
    "terminal.ansiBrightRed": "#d1352a",
    "terminal.ansiBrightGreen": "#3d7a45",
    "terminal.ansiBrightYellow": "#a15c00",
    "terminal.ansiBrightBlue": "#2a72b5",
    "terminal.ansiBrightMagenta": "#a04fb8",
    "terminal.ansiBrightCyan": "#117f7f",
    "terminal.ansiBrightWhite": "#3a4f42"
