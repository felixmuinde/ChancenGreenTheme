  "semanticTokenColors": {
    "namespace": "#0f6b6b",
    "class": "#1F4834",
    "interface": "#1F4834",
    "enum": "#1F4834",
    "typeParameter": "#1F4834",
    "function": "#0f6b6b",
    "method": "#0f6b6b",
    "property": "#0f1e12",
    "parameter": { "foreground": "#6b5513", "italic": true },
    "variable.readonly": "#a24b0b"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#566f5e", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#8a5a00" }
    },
    {
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": { "foreground": "#a24b0b" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.other"],
      "settings": { "foreground": "#a24b0b" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "keyword.operator.new"],
      "settings": { "foreground": "#2f6a3a" }
    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#3e5a48" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#0f6b6b" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class"],
      "settings": { "foreground": "#1F4834", "fontStyle": "bold" }
    },
    {
      "scope": ["variable", "variable.other", "meta.object-literal.key"],
      "settings": { "foreground": "#0f1e12" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#6b5513", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#2f6a3a" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#8a5a00" }
    },
    {
      "scope": ["support.type.property-name", "meta.property-name"],
      "settings": { "foreground": "#1F4834" }
    },
    {
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#4a6354" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#1F4834", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#0f1e12", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#8a5a00" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#0f6b6b" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#2f7d3a" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#b42318" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#b42318" }
    }
  ]
}
