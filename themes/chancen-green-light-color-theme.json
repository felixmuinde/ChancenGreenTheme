    "scrollbarSlider.background": "#1F483433",
    "scrollbarSlider.hoverBackground": "#1F483466",
    "scrollbarSlider.activeBackground": "#1F483499",
    "minimap.background": "#f6f4ee",
    "minimap.selectionHighlight": "#84BD00bb",
    "minimap.findMatchHighlight": "#a0d931bb",
    "minimapSlider.background": "#1F483422",
    "minimapSlider.hoverBackground": "#1F483444",
    "minimapSlider.activeBackground": "#1F483466",

    "notifications.background": "#ffffff",
    "notifications.foreground": "#0f1e12",
    "notifications.border": "#d5dcc5",
    "notificationCenterHeader.background": "#eef4e1",
    "notificationLink.foreground": "#2f6a3a",
    "notificationsErrorIcon.foreground": "#b42318",
    "notificationsWarningIcon.foreground": "#a15c00",
    "notificationsInfoIcon.foreground": "#0f6b6b",
    "pickerGroup.foreground": "#2f6a3a",
    "pickerGroup.border": "#d5dcc5",
    "quickInput.background": "#ffffff",
    "quickInputList.focusBackground": "#cfe49a",
    "quickInputList.focusForeground": "#0f1e12",

    "diffEditor.insertedTextBackground": "#84BD0040",
    "diffEditor.removedTextBackground": "#b4231826",
    "diffEditor.insertedLineBackground": "#84BD001f",
    "diffEditor.removedLineBackground": "#b4231814",
