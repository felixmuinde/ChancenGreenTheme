    "gitDecoration.modifiedResourceForeground": "#8a5a00",
    "gitDecoration.deletedResourceForeground": "#b42318",
    "gitDecoration.untrackedResourceForeground": "#2f6a3a",
    "gitDecoration.ignoredResourceForeground": "#6f8576",
    "gitDecoration.conflictingResourceForeground": "#a24b0b",
    "gitDecoration.submoduleResourceForeground": "#0f6b6b",

    "terminal.background": "#f6f4ee",
    "terminal.foreground": "#0f1e12",
    "terminal.selectionBackground": "#cfe49a",
    "terminalCursor.foreground": "#1F4834",
